# Deterministic line endings for the rewrite (Prisma checksums migrations by bytes).
# The directory-scoped text=auto rules below deliberately omit the legacy trees (chineseschool/,
# chineseschool-rails2.3.12/, data-export/), whose committed CRLF files are left untouched. The
# extension rules (*.sql ... *.yml) and the binary rules apply repo-wide, legacy trees included;
# every legacy file they match was already stored LF (or binary), so they cause no churn there.

/.gitattributes text eol=lf
/.gitignore text eol=lf
/.gitmodules text eol=lf
/.nvmrc text eol=lf
/.dockerignore text eol=lf

backend/** text=auto eol=lf
frontend/** text=auto eol=lf
deploy/** text=auto eol=lf
scripts/** text=auto eol=lf
.github/** text=auto eol=lf
docs/** text=auto eol=lf

*.sql text eol=lf
*.sh text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.ttf binary
*.woff binary
*.woff2 binary
