# Settings for deploy/backup.sh (and deploy.sh, which runs it before every deploy). Copy to /opt/tocs/backup.env
# (owner deploy, mode 600). backup.sh parses KEY=VALUE lines for the four keys below (never sources the file); a
# variable already set in the environment wins. Nothing in this file is a decryption secret.
#
# The age IDENTITY (private key, AGE-SECRET-KEY-1...) must NOT live on the production host: whoever holds it can
# read every backup. Generate the pair offline (`age-keygen -o tocs-backup.key`), store the identity in the password
# manager / offline media, and put only the PUBLIC key printed by `age-keygen -y tocs-backup.key` below.
# restore.sh reads the identity from BACKUP_AGE_IDENTITY_FILE on the machine doing the restore.

# Required. age PUBLIC key (age1...). Deliberately EMPTY: backup.sh (and therefore every deploy) refuses to run
# until it is filled in.
BACKUP_AGE_RECIPIENT=

# Optional rclone destination for an off-site copy, e.g. offsite:tocs-backups (remote defined in RCLONE_CONFIG).
# Keep credentials in the rclone config file, not inline here. When set, a failed upload makes backup.sh exit 4,
# which also aborts a deploy (fail-safe). Remote retention: use the storage provider's lifecycle rules.
BACKUP_REMOTE=

# Local retention in /opt/tocs/backups, in days (1..3650). Only tocs-<timestamp>-<db>.dump.age[.sha256] files are
# pruned; the newest artifact is always kept.
BACKUP_RETENTION_DAYS=14

# Optional path of the rclone config file (mode 600), e.g. /opt/tocs/rclone.conf.
RCLONE_CONFIG=
