# {{ ansible_managed }} (deploy/ansible, role app). Rendered from vault variables: edits here are overwritten on
# the next run; change the variables instead. Owner {{ deploy_user }}, mode 600. Key names: deploy/.env.prod.example.
# Values are single-quoted (literal for docker compose; deploy.sh strips the quotes).

GHCR_OWNER='{{ ghcr_owner }}'
IMAGE_TAG='{{ image_tag }}'

SITE_ADDRESS='{{ site_address }}'
CADDY_TLS='{{ caddy_tls }}'
HTTP_PORT='{{ http_port }}'
HTTPS_PORT='{{ https_port }}'

APP_BASE_URL='{{ app_base_url }}'
SESSION_SECRET='{{ session_secret }}'
MAIL_TRANSPORT='{{ mail_transport }}'
SMTP_URL='{{ smtp_url | default('') }}'
TRUST_PROXY='{{ trust_proxy }}'
LOG_LEVEL='{{ log_level }}'

POSTGRES_USER='{{ postgres_user }}'
POSTGRES_DB='{{ postgres_db }}'
POSTGRES_PASSWORD='{{ postgres_password }}'
TOCS_MIGRATOR_PASSWORD='{{ tocs_migrator_password }}'
TOCS_APP_PASSWORD='{{ tocs_app_password }}'
