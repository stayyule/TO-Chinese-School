# Ansible controller for deploy/test/ansible-check.sh (local tests only; never used against a real host).
# Pinned: ansible-core, ansible-lint and community.general (same version as deploy/ansible/requirements.yml).
FROM python:3.12-slim-bookworm

ARG ANSIBLE_CORE_VERSION=2.20.11
ARG ANSIBLE_LINT_VERSION=26.6.0
ARG COMMUNITY_GENERAL_VERSION=12.6.6

RUN apt-get update \
 && apt-get install -y --no-install-recommends openssh-client age openssl git \
 && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir "ansible-core==${ANSIBLE_CORE_VERSION}" "ansible-lint==${ANSIBLE_LINT_VERSION}"

RUN ansible-galaxy collection install -p /usr/share/ansible/collections "community.general:==${COMMUNITY_GENERAL_VERSION}"

ENV ANSIBLE_COLLECTIONS_PATH=/usr/share/ansible/collections \
    ANSIBLE_NOCOLOR=1 \
    ANSIBLE_FORCE_COLOR=0 \
    ANSIBLE_RETRY_FILES_ENABLED=0 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /work
