# Throwaway "fresh Ubuntu 24.04 host" for deploy/test/ansible-check.sh: systemd as PID 1, sshd, python3 and an
# admin user with passwordless sudo (like the default `ubuntu` user of a cloud image). The admin user's public key is
# copied in at run time (a throwaway key generated by the test); nothing secret is baked into the image.
# Runs ONLY as a local privileged test container (systemd + nested dockerd + ufw need it).
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends systemd systemd-sysv dbus openssh-server python3 sudo ca-certificates \
      iproute2 kmod \
 && rm -rf /var/lib/apt/lists/*

# opsadmin: the operator's account Ansible connects as. outsider: must NOT be allowed to log in after hardening.
# opsother: a second sudo user (negative test: connecting as a user that is not admin_user). nokeys / emptykeys:
# candidate admin users without / with an empty authorized_keys (negative tests of the lock-out guard).
RUN for u in opsadmin outsider opsother nokeys emptykeys; do useradd -m -s /bin/bash "$u" && usermod -p '*' "$u"; done \
 && printf 'opsadmin ALL=(ALL) NOPASSWD:ALL\nopsother ALL=(ALL) NOPASSWD:ALL\n' >/etc/sudoers.d/90-ops \
 && chmod 440 /etc/sudoers.d/90-ops \
 && for u in opsadmin outsider opsother emptykeys; do install -d -m 700 -o "$u" -g "$u" "/home/$u/.ssh"; done \
 && install -m 600 -o emptykeys -g emptykeys /dev/null /home/emptykeys/.ssh/authorized_keys \
 && rm -f /etc/systemd/system/multi-user.target.wants/systemd-resolved.service

STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
