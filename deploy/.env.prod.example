# Production settings for deploy/compose.prod.yml. Copy to deploy/.env.prod, fill in, `chmod 600`, never commit
# (.env.* is git-ignored). Use with: docker compose -p tocs --env-file deploy/.env.prod -f deploy/compose.prod.yml ...
# Passwords: letters and digits only (e.g. `openssl rand -hex 24`); they are embedded in connection URLs and in
# PGOPTIONS, where URL metacharacters or spaces would break parsing.
# Every secret (and every deployment-specific value) is deliberately EMPTY: compose refuses to start (`${VAR:?}`)
# until each one is filled in, and the api refuses placeholder text (replace-with/changeme) as a secret.
# BEFORE THE FIRST `up`: restore the legacy baseline (production dump) into the postgres volume; on an empty database
# the foundation migration fails and the api never starts (see backend/prisma/migrations/README.md).

# --- Images (built and pushed by CI): ghcr.io/<GHCR_OWNER>/tocs-api:<IMAGE_TAG>, ...:<IMAGE_TAG>-migrate,
# ghcr.io/<GHCR_OWNER>/tocs-web:<IMAGE_TAG>. Pin an immutable tag (e.g. the git SHA), never `latest`.
# e.g. GHCR_OWNER=<github-org-or-user>, IMAGE_TAG=<git-sha>
GHCR_OWNER=
IMAGE_TAG=

# --- Edge (Caddy)
# Public host name; Caddy obtains its Let's Encrypt certificate automatically (ports 80 and 443 must reach the host).
SITE_ADDRESS=register.to-cs.org
# Argument of Caddy's `tls` directive: the ACME account e-mail in production (`internal` = local CA, tests only).
CADDY_TLS=
# Host ports (optionally IP:port) published for Caddy's 8080 (HTTP) and 8443 (HTTPS).
HTTP_PORT=80
HTTPS_PORT=443

# --- Application (api)
# Absolute base URL used in e-mailed links; must match SITE_ADDRESS.
APP_BASE_URL=https://register.to-cs.org
# Generate: openssl rand -hex 32
SESSION_SECRET=
# smtp (SMTP_URL required) or memory (development only: mail is not delivered).
MAIL_TRANSPORT=smtp
# Format: smtps://<user>:<password>@<smtp-host>:465 (percent-encode special characters in the credentials).
# Required when MAIL_TRANSPORT=smtp (the api refuses to boot without it).
SMTP_URL=
# Express `trust proxy`: 1 = believe only the X-Forwarded-For entry set by Caddy (the only hop). Alternatives: the
# edge network's subnet (e.g. 172.30.0.0/16). Never `true`. Leaving it empty in compose.prod.yml means 1.
TRUST_PROXY=1
LOG_LEVEL=info

# --- Database (postgres service; reachable only on the internal Docker network)
POSTGRES_USER=postgres
POSTGRES_DB=tocs
# Superuser password (administration only; the app never uses it). Generate: openssl rand -hex 24
POSTGRES_PASSWORD=
# tocs_migrator (DDL: the migrate service) and tocs_app (DML: the api). init-roles.sql creates the roles with these
# on first start of an empty data volume; afterwards change them with ALTER ROLE (and here) together.
# Generate each: openssl rand -hex 24
TOCS_MIGRATOR_PASSWORD=
TOCS_APP_PASSWORD=
