NODE_ENV=development
# Runtime (app) account: DML only. Dev password matches deploy/db/init-roles.sql defaults.
DATABASE_URL=postgresql://tocs_app:tocs_app_dev@localhost:5433/tocs_dev
# Migration account (prisma migrate deploy via schema directUrl): owns schema public, may run DDL.
DATABASE_MIGRATOR_URL=postgresql://tocs_migrator:tocs_migrator_dev@localhost:5433/tocs_dev
# Override the dev role passwords (compose / init-roles.sql); never commit real ones.
# TOCS_MIGRATOR_PASSWORD=tocs_migrator_dev
# TOCS_APP_PASSWORD=tocs_app_dev
SESSION_SECRET=change-me-to-a-long-random-string
APP_BASE_URL=http://localhost:5173
# MAIL_TRANSPORT: smtp (default; SMTP_URL is then REQUIRED, the app refuses to boot without it) or memory (no SMTP_URL needed).
SMTP_URL=smtp://localhost:1025
MAIL_TRANSPORT=smtp

# Integration tests (npm run test:int) connect as the superuser to the URL below (default shown) to rebuild the
# database, then as tocs_app (same host/database; password TOCS_APP_PASSWORD, default tocs_app_dev).
# The database name MUST end with _test: global setup drops and recreates schema public, applies
# db/baseline.sql, every prisma migration, deploy/db/init-roles.sql and deploy/db/grants.sql.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/tocs_test
